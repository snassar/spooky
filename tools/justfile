# Tools Orchestration
# This justfile orchestrates all developer tools in the tools/ directory

# Build all tools
build:
    @echo "Building all tools..."
    @cd dependency-graph && just build
    @cd terminology-checker && just build
    @cd adr-generator && just build
    @cd todo-linter && just build
    @cd git-adr-analyzer && just build
    @cd focused-adr-analyzer && just build
    @cd simple-adr-generator && just build

# Run all tools
run-all: build
    @echo "Running all tools..."
    @cd dependency-graph && just run
    @cd terminology-checker && just run
    @cd adr-generator && just run
    @cd todo-linter && just run
    @cd git-adr-analyzer && just run
    @cd focused-adr-analyzer && just run
    @cd simple-adr-generator && just run

# Clean all tools
clean:
    @echo "Cleaning all tools..."
    @cd dependency-graph && just clean
    @cd terminology-checker && just clean
    @cd adr-generator && just clean
    @cd todo-linter && just clean
    @cd git-adr-analyzer && just clean
    @cd focused-adr-analyzer && just clean
    @cd simple-adr-generator && just clean

# Show help for all tools
help:
    @echo "Available Tools:"
    @echo "  dependency-graph       - Analyze package dependencies"
    @echo "  terminology-checker    - Check terminology compliance"
    @echo "  adr-generator         - Generate ADR documentation"
    @echo "  todo-linter           - Lint TODO comments"
    @echo "  git-adr-analyzer      - Analyze ADRs from Git history"
    @echo "  focused-adr-analyzer  - Perform focused ADR analysis"
    @echo "  simple-adr-generator  - Generate simple ADR documentation"
    @echo ""
    @echo "Legacy Tools (not integrated):"
    @echo "  pre-commit            - Pre-commit hooks and checks"
    @echo ""
    @echo "Run 'cd <tool> && just help' for tool-specific help"
    @echo ""
    @echo "Commands:"
    @echo "  build    - Build all tools"
    @echo "  run-all  - Run all tools"
    @echo "  clean    - Clean all tools"
    @echo "  help     - Show this help"
