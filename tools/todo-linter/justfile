# TODO Linter Tool
# Lints TODO comments in the codebase

# Build the tool
build:
    @echo "Building TODO linter tool..."
    go build -o todo-linter main.go

# Run the tool
run: build
    @echo "Linting TODO comments..."
    @cd ../.. && ./tools/todo-linter/todo-linter

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    rm -f todo-linter

# Show help
help:
    @echo "TODO Linter Tool"
    @echo ""
    @echo "Purpose: Lint TODO comments in the codebase"
    @echo ""
    @echo "Commands:"
    @echo "  build   - Build the tool"
    @echo "  run     - Lint TODO comments"
    @echo "  clean   - Clean build artifacts"
    @echo "  help    - Show this help"
