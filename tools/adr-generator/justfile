# ADR Generator Tool
# Generates ADR (Architecture Decision Record) documentation

# Build the tool
build:
    @echo "Building ADR generator tool..."
    go build -o adr-generator main.go

# Run the tool
run: build
    @echo "Generating ADR documentation..."
    ./adr-generator

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    rm -f adr-generator

# Show help
help:
    @echo "ADR Generator Tool"
    @echo ""
    @echo "Purpose: Generate ADR (Architecture Decision Record) documentation"
    @echo ""
    @echo "Commands:"
    @echo "  build   - Build the tool"
    @echo "  run     - Generate ADR documentation"
    @echo "  clean   - Clean build artifacts"
    @echo "  help    - Show this help"
