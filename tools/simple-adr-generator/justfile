# Simple ADR Generator Tool
# Generates simple ADR documentation

# Build the tool
build:
    @echo "Building simple ADR generator tool..."
    go build -o simple-adr-generator main.go

# Run the tool
run: build
    @echo "Generating simple ADR documentation..."
    ./simple-adr-generator

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    rm -f simple-adr-generator

# Show help
help:
    @echo "Simple ADR Generator Tool"
    @echo ""
    @echo "Purpose: Generate simple ADR documentation"
    @echo ""
    @echo "Commands:"
    @echo "  build   - Build the tool"
    @echo "  run     - Generate simple ADR documentation"
    @echo "  clean   - Clean build artifacts"
    @echo "  help    - Show this help"
