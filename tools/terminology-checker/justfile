# Terminology Checker Justfile

# Build the terminology checker
build:
    @echo "Building terminology checker tool..."
    go build -o terminology-checker main.go

# Test the terminology checker
test:
    go test -v

# Install the terminology checker
install: build
    go install
    @echo "Terminology checker installed successfully!"

# Run the terminology checker on the codebase
run:
    @echo "Running terminology checker..."
    go build -o terminology-checker main.go
    ./terminology-checker ../../internal ../../cmd

# Run the terminology checker with verbose output
lint-verbose:
    @echo "Running terminology checker with verbose output..."
    go build -o terminology-checker main.go
    ./terminology-checker -v ../../internal ../../cmd

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    rm -f terminology-checker

# Show help
default:
    @just --list
