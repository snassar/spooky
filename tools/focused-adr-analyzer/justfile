# Focused ADR Analyzer Tool
# Performs focused analysis of ADRs

# Build the tool
build:
    @echo "Building focused ADR analyzer tool..."
    go build -o focused-adr-analyzer main.go

# Run the tool
run: build
    @echo "Performing focused ADR analysis..."
    ./focused-adr-analyzer

# Clean build artifacts
clean:
    @echo "Cleaning build artifacts..."
    rm -f focused-adr-analyzer

# Show help
help:
    @echo "Focused ADR Analyzer Tool"
    @echo ""
    @echo "Purpose: Perform focused analysis of ADRs"
    @echo ""
    @echo "Commands:"
    @echo "  build   - Build the tool"
    @echo "  run     - Perform focused ADR analysis"
    @echo "  clean   - Clean build artifacts"
    @echo "  help    - Show this help"
