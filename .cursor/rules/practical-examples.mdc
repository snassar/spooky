### 1. Common Configuration Issues

#### HCL Validation Errors
```go
// Problem: HCL parsing fails
func troubleshootHCLParsing(data []byte) error {
    var result interface{}
    if err := hcl.Unmarshal(data, &result); err != nil {
        // Provide helpful error message
        return fmt.Errorf("HCL parsing failed: %w\n\n"+
            "Common causes:\n"+
            "- Missing required fields\n"+
            "- Invalid syntax (check brackets, quotes)\n"+
            "- Unsupported attribute types\n"+
            "- File encoding issues", err)
    }
    return nil
}
