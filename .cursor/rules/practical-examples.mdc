## Performance Optimization Examples

### 1. Caching Strategies

#### Intelligent Caching
```go
// Good: Smart caching with TTL and invalidation
type SmartCache struct {
    data    map[string]cacheEntry
    mutex   sync.RWMutex
    maxSize int
    ttl     time.Duration
}

type cacheEntry struct {
    value      interface{}
    expiresAt  time.Time
    accessCount int
}

func (c *SmartCache) Get(key string) (interface{}, bool) {
    c.mutex.RLock()
    entry, exists := c.data[key]
    c.mutex.RUnlock()
    
    if !exists {
        return nil, false
    }
    
    // Check expiration
    if time.Now().After(entry.expiresAt) {
        c.mutex.Lock()
        delete(c.data, key)
        c.mutex.Unlock()
        return nil, false
    }
    
    // Update access count
    c.mutex.Lock()
    entry.accessCount++
    c.data[key] = entry
    c.mutex.Unlock()
    
    return entry.value, true
}
```

