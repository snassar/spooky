# Security Implementation

## Quick Reference for AI Assistants

### Decision Tree: Which Security Pattern to Apply?

1. **Are you implementing SSH authentication?**
   - **Yes** → Use Ed25519-only key patterns
   - **No** → Continue to step 2

2. **Are you handling sensitive data?**
   - **Yes** → Use encryption and secure storage patterns
   - **No** → Continue to step 3

3. **Are you validating input data?**
   - **Yes** → Use comprehensive validation patterns
   - **No** → Continue to step 4

4. **Are you implementing access controls?**
   - **Yes** → Use principle of least privilege patterns
   - **No** → Use general security patterns

### AI Action Items

**ALWAYS DO:**
- Use Ed25519 keys or RSA 4096-bit keys for SSH
- Validate SSH key formats and permissions
- Encrypt sensitive configuration data
- Implement proper input validation
- Use secure defaults for timeouts and limits

**NEVER DO:**
- Use DSA keys or weak RSA keys (< 4096 bits) for SSH
- Log sensitive information (passwords, keys)
- Skip input validation
- Use hardcoded credentials
- Ignore file permission requirements

## Core Principles

### 1. SSH Security Standards
- **Ed25519 and RSA 4096-bit**: Support Ed25519 keys and RSA 4096-bit keys (no DSA or weak RSA)
- **Key validation**: Validate SSH key formats and permissions
- **Secure defaults**: Use secure defaults for timeouts and connection limits
- **Authentication failures**: Implement proper error handling for authentication failures
- **Host key validation**: Validate host keys to prevent MITM attacks

### 2. Configuration Security
- **No hardcoded credentials**: Never hardcode passwords or keys in code
- **Environment variables**: Use environment variables for sensitive data
- **File permissions**: Validate configuration file permissions
- **Input validation**: Implement proper input validation for all configuration fields
- **Encryption**: Encrypt sensitive configuration data

### 3. Data Protection
- **Sensitive data handling**: Handle sensitive data with appropriate security measures
- **Logging security**: Never log sensitive information
- **Memory security**: Clear sensitive data from memory when possible
- **Transport security**: Use secure transport protocols
- **Storage security**: Encrypt sensitive data at rest

## Implementation Guidelines

### SSH Key Validation
```go
// SSH key validation and security
type SSHKeyValidator struct {
    allowedKeyTypes []string
    minKeySize      int
    maxKeySize      int
}

func NewSSHKeyValidator() *SSHKeyValidator {
    return &SSHKeyValidator{
        allowedKeyTypes: []string{"ssh-ed25519", "ssh-rsa"}, // Ed25519 and RSA
        minKeySize:      256,
        maxKeySize:      4096, // Support up to RSA 4096-bit
    }
}

func (v *SSHKeyValidator) ValidateKey(keyPath string) error {
    // Check file permissions (should be 600)
    if err := v.validateKeyPermissions(keyPath); err != nil {
        return fmt.Errorf("invalid key permissions: %w", err)
    }
    
    // Read and parse key
    keyData, err := os.ReadFile(keyPath)
    if err != nil {
        return fmt.Errorf("failed to read key file: %w", err)
    }
    
    // Validate key type
    if err := v.validateKeyType(keyData); err != nil {
        return fmt.Errorf("invalid key type: %w", err)
    }
    
    // Validate key size
    if err := v.validateKeySize(keyData); err != nil {
        return fmt.Errorf("invalid key size: %w", err)
    }
    
    return nil
}

func (v *SSHKeyValidator) validateKeyPermissions(keyPath string) error {
    info, err := os.Stat(keyPath)
    if err != nil {
        return err
    }
    
    mode := info.Mode()
    if mode&0077 != 0 {
        return fmt.Errorf("key file has too permissive permissions: %v", mode)
    }
    
    return nil
}

func (v *SSHKeyValidator) validateKeyType(keyData []byte) error {
    key, err := ssh.ParsePrivateKey(keyData)
    if err != nil {
        return fmt.Errorf("failed to parse private key: %w", err)
    }
    
    keyType := key.PublicKey().Type()
    for _, allowed := range v.allowedKeyTypes {
        if keyType == allowed {
            return nil
        }
    }
    
    return fmt.Errorf("unsupported key type: %s (only %v allowed)", keyType, v.allowedKeyTypes)
}

func (v *SSHKeyValidator) validateKeySize(keyData []byte) error {
    key, err := ssh.ParsePrivateKey(keyData)
    if err != nil {
        return fmt.Errorf("failed to parse private key: %w", err)
    }
    
    keyType := key.PublicKey().Type()
    
    // Ed25519 keys are always 256 bits
    if keyType == "ssh-ed25519" {
        return nil
    }
    
    // For RSA keys, validate minimum size
    if keyType == "ssh-rsa" {
        // Extract RSA key size (this is a simplified example)
        // In practice, you'd need to parse the RSA key to get its actual size
        if len(keyData) < 1024 { // Rough estimate for minimum RSA key size
            return fmt.Errorf("RSA key size too small (minimum 2048 bits recommended, 4096 bits preferred)")
        }
    }
    
    return nil
}
```

### Secure Configuration Handling
```go
// Secure configuration management
type SecureConfig struct {
    encryptedData map[string][]byte
    keyManager    KeyManager
}

func NewSecureConfig(keyManager KeyManager) *SecureConfig {
    return &SecureConfig{
        encryptedData: make(map[string][]byte),
        keyManager:    keyManager,
    }
}

func (c *SecureConfig) SetSecureValue(key string, value []byte) error {
    // Encrypt sensitive data
    encrypted, err := c.keyManager.Encrypt(value)
    if err != nil {
        return fmt.Errorf("failed to encrypt value: %w", err)
    }
    
    c.encryptedData[key] = encrypted
    return nil
}

func (c *SecureConfig) GetSecureValue(key string) ([]byte, error) {
    encrypted, exists := c.encryptedData[key]
    if !exists {
        return nil, fmt.Errorf("key not found: %s", key)
    }
    
    // Decrypt sensitive data
    decrypted, err := c.keyManager.Decrypt(encrypted)
    if err != nil {
        return nil, fmt.Errorf("failed to decrypt value: %w", err)
    }
    
    return decrypted, nil
}

func (c *SecureConfig) ClearSecureData() {
    // Clear sensitive data from memory
    for key := range c.encryptedData {
        // Overwrite with zeros
        for i := range c.encryptedData[key] {
            c.encryptedData[key][i] = 0
        }
        delete(c.encryptedData, key)
    }
}
```

### Input Validation
```go
// Comprehensive input validation
type InputValidator struct {
    maxStringLength int
    allowedChars    *regexp.Regexp
    forbiddenPatterns []*regexp.Regexp
}

func NewInputValidator() *InputValidator {
    return &InputValidator{
        maxStringLength: 1024,
        allowedChars:    regexp.MustCompile(`^[a-zA-Z0-9\-_\.@:]+$`),
        forbiddenPatterns: []*regexp.Regexp{
            regexp.MustCompile(`(?i)(password|secret|key|token)`),
            regexp.MustCompile(`(?i)(eval|exec|system|shell)`),
            regexp.MustCompile(`[<>\"'&]`), // HTML/XML injection
        },
    }
}

func (v *InputValidator) ValidateString(input string, fieldName string) error {
    if len(input) > v.maxStringLength {
        return fmt.Errorf("%s exceeds maximum length of %d", fieldName, v.maxStringLength)
    }
    
    if !v.allowedChars.MatchString(input) {
        return fmt.Errorf("%s contains invalid characters", fieldName)
    }
    
    for _, pattern := range v.forbiddenPatterns {
        if pattern.MatchString(input) {
            return fmt.Errorf("%s contains forbidden pattern: %s", fieldName, pattern.String())
        }
    }
    
    return nil
}

func (v *InputValidator) ValidateHostname(hostname string) error {
    if hostname == "" {
        return fmt.Errorf("hostname cannot be empty")
    }
    
    // Validate hostname format
    if len(hostname) > 253 {
        return fmt.Errorf("hostname too long")
    }
    
    // Check for valid hostname characters
    hostnameRegex := regexp.MustCompile(`^[a-zA-Z0-9]([a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?$`)
    if !hostnameRegex.MatchString(hostname) {
        return fmt.Errorf("invalid hostname format")
    }
    
    return nil
}

func (v *InputValidator) ValidatePort(port int) error {
    if port <= 0 || port > 65535 {
        return fmt.Errorf("port must be between 1 and 65535")
    }
    
    // Check for common restricted ports
    restrictedPorts := []int{22, 80, 443, 8080}
    for _, restricted := range restrictedPorts {
        if port == restricted {
            return fmt.Errorf("port %d is restricted", port)
        }
    }
    
    return nil
}
```

### Secure Logging
```go
// Secure logging implementation
type SecureLogger struct {
    logger     Logger
    sensitiveFields []string
}

func NewSecureLogger(logger Logger) *SecureLogger {
    return &SecureLogger{
        logger: logger,
        sensitiveFields: []string{
            "password", "secret", "key", "token", "credential",
            "private_key", "ssh_key", "auth_key",
        },
    }
}

func (l *SecureLogger) Info(msg string, fields ...Field) {
    l.logger.Info(msg, l.sanitizeFields(fields)...)
}

func (l *SecureLogger) Error(msg string, fields ...Field) {
    l.logger.Error(msg, l.sanitizeFields(fields)...)
}

func (l *SecureLogger) sanitizeFields(fields []Field) []Field {
    sanitized := make([]Field, len(fields))
    for i, field := range fields {
        if l.isSensitiveField(field.Key) {
            sanitized[i] = String(field.Key, "[REDACTED]")
        } else {
            sanitized[i] = field
        }
    }
    return sanitized
}

func (l *SecureLogger) isSensitiveField(key string) bool {
    keyLower := strings.ToLower(key)
    for _, sensitive := range l.sensitiveFields {
        if strings.Contains(keyLower, sensitive) {
            return true
        }
    }
    return false
}
```

