## Security Best Practices

### Environment Variable Security
```go
// Secure environment variable handling
func GetSecureEnvVar(key string) (string, error) {
    value := os.Getenv(key)
    if value == "" {
        return "", fmt.Errorf("environment variable %s not set", key)
    }
    
    // Validate environment variable value
    if err := validateEnvVarValue(value); err != nil {
        return "", fmt.Errorf("invalid environment variable %s: %w", key, err)
    }
    
    return value, nil
}

func validateEnvVarValue(value string) error {
    // Check for common security issues
    if strings.Contains(value, "password") || strings.Contains(value, "secret") {
        return fmt.Errorf("environment variable contains sensitive keywords")
    }
    
    if len(value) > 1024 {
        return fmt.Errorf("environment variable value too long")
    }
    
    return nil
}
```

### File Permission Security
```go
// File permission validation
func ValidateFilePermissions(filePath string, expectedMode os.FileMode) error {
    info, err := os.Stat(filePath)
    if err != nil {
        return fmt.Errorf("failed to stat file: %w", err)
    }
    
    actualMode := info.Mode()
    if actualMode != expectedMode {
        return fmt.Errorf("file %s has incorrect permissions: expected %v, got %v", 
            filePath, expectedMode, actualMode)
    }
    
    return nil
}

func SetSecureFilePermissions(filePath string) error {
    // Set restrictive permissions (600 for private keys, 644 for config files)
    return os.Chmod(filePath, 0600)
}
```

