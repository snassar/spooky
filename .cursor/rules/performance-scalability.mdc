# Performance and Scalability

## Quick Reference for AI Assistants

### Decision Tree: Which Performance Pattern to Apply?

1. **Are you implementing connection pooling?**
   - **Yes** → Use efficient connection pool patterns
   - **No** → Continue to step 2

2. **Are you handling large-scale deployments?**
   - **Yes** → Use parallel execution patterns
   - **No** → Continue to step 3

3. **Are you optimizing resource usage?**
   - **Yes** → Use resource management patterns
   - **No** → Continue to step 4

4. **Are you implementing caching?**
   - **Yes** → Use intelligent caching patterns
   - **No** → Use general performance patterns

### AI Action Items

**ALWAYS DO:**
- Implement efficient connection pooling
- Use parallel execution for large-scale operations
- Monitor memory usage during operations
- Implement configurable timeouts
- Use tag-based targeting for flexible grouping

**NEVER DO:**
- Create unbounded connection pools
- Ignore resource limits
- Use blocking operations without timeouts
- Skip memory monitoring
- Implement inefficient serial processing

## Core Principles

### 1. Large-Scale Deployment Support
- **Parallel execution**: Support parallel execution across multiple servers
- **Configurable timeouts**: Prevent hanging connections
- **Efficient SSH connection pooling**: Reuse connections when possible
- **Tag-based targeting**: Flexible server grouping for operations
- **Resource management**: Limit concurrent connections to prevent exhaustion

### 2. Resource Management
- **Connection limits**: Limit concurrent connections to prevent resource exhaustion
- **Connection timeouts**: Implement timeouts to prevent hanging connections
- **Connection pooling**: Use connection pooling where appropriate
- **Memory monitoring**: Monitor memory usage during large operations
- **Graceful degradation**: Handle resource exhaustion gracefully

### 3. Performance Optimization
- **Efficient algorithms**: Use efficient algorithms for data processing
- **Memory allocation**: Optimize memory allocation patterns
- **Caching strategies**: Implement intelligent caching where appropriate
- **Batch processing**: Process data in batches for efficiency
- **Lazy loading**: Load data only when needed

## Implementation Guidelines

### Connection Pooling
```go
// Efficient SSH connection pooling
type SSHConnectionPool struct {
    connections map[string]*SSHConnection
    mutex       sync.RWMutex
    maxConnections int
    timeout       time.Duration
    cleanupInterval time.Duration
}

type SSHConnection struct {
    client    *ssh.Client
    lastUsed  time.Time
    healthy   bool
}

func NewSSHConnectionPool(maxConnections int, timeout time.Duration) *SSHConnectionPool {
    pool := &SSHConnectionPool{
        connections:     make(map[string]*SSHConnection),
        maxConnections:  maxConnections,
        timeout:         timeout,
        cleanupInterval: 5 * time.Minute,
    }
    
    // Start cleanup goroutine
    go pool.cleanupRoutine()
    
    return pool
}

func (p *SSHConnectionPool) GetConnection(host string, config *SSHConfig) (*ssh.Client, error) {
    p.mutex.RLock()
    if conn, exists := p.connections[host]; exists && conn.healthy {
        conn.lastUsed = time.Now()
        p.mutex.RUnlock()
        return conn.client, nil
    }
    p.mutex.RUnlock()
    
    // Create new connection
    p.mutex.Lock()
    defer p.mutex.Unlock()
    
    // Check if we're at capacity
    if len(p.connections) >= p.maxConnections {
        // Remove least recently used connection
        p.removeLRUConnection()
    }
    
    client, err := p.createConnection(host, config)
    if err != nil {
        return nil, fmt.Errorf("failed to create SSH connection to %s: %w", host, err)
    }
    
    p.connections[host] = &SSHConnection{
        client:   client,
        lastUsed: time.Now(),
        healthy:  true,
    }
    
    return client, nil
}

func (p *SSHConnectionPool) removeLRUConnection() {
    var oldestHost string
    var oldestTime time.Time
    
    for host, conn := range p.connections {
        if oldestHost == "" || conn.lastUsed.Before(oldestTime) {
            oldestHost = host
            oldestTime = conn.lastUsed
        }
    }
    
    if oldestHost != "" {
        if conn := p.connections[oldestHost]; conn != nil {
            conn.client.Close()
        }
        delete(p.connections, oldestHost)
    }
}

func (p *SSHConnectionPool) cleanupRoutine() {
    ticker := time.NewTicker(p.cleanupInterval)
    defer ticker.Stop()
    
    for range ticker.C {
        p.cleanupStaleConnections()
    }
}

func (p *SSHConnectionPool) cleanupStaleConnections() {
    p.mutex.Lock()
    defer p.mutex.Unlock()
    
    cutoff := time.Now().Add(-p.timeout)
    for host, conn := range p.connections {
        if conn.lastUsed.Before(cutoff) {
            conn.client.Close()
            delete(p.connections, host)
        }
    }
}
```

### Parallel Execution
```go
// Parallel execution for large-scale operations
type ParallelExecutor struct {
    maxWorkers int
    timeout    time.Duration
    semaphore  chan struct{}
}

func NewParallelExecutor(maxWorkers int, timeout time.Duration) *ParallelExecutor {
    return &ParallelExecutor{
        maxWorkers: maxWorkers,
        timeout:    timeout,
        semaphore:  make(chan struct{}, maxWorkers),
    }
}

func (e *ParallelExecutor) ExecuteParallel(servers []string, operation func(string) error) []ExecutionResult {
    results := make([]ExecutionResult, len(servers))
    var wg sync.WaitGroup
    
    for i, server := range servers {
        wg.Add(1)
        go func(index int, host string) {
            defer wg.Done()
            
            // Acquire semaphore
            e.semaphore <- struct{}{}
            defer func() { <-e.semaphore }()
            
            // Execute operation with timeout
            result := e.executeWithTimeout(host, operation)
            results[index] = result
        }(i, server)
    }
    
    wg.Wait()
    return results
}

type ExecutionResult struct {
    Server  string
    Error   error
    Duration time.Duration
}

func (e *ParallelExecutor) executeWithTimeout(server string, operation func(string) error) ExecutionResult {
    start := time.Now()
    
    // Create context with timeout
    ctx, cancel := context.WithTimeout(context.Background(), e.timeout)
    defer cancel()
    
    // Execute operation in goroutine
    errChan := make(chan error, 1)
    go func() {
        errChan <- operation(server)
    }()
    
    // Wait for completion or timeout
    select {
    case err := <-errChan:
        return ExecutionResult{
            Server:   server,
            Error:    err,
            Duration: time.Since(start),
        }
    case <-ctx.Done():
        return ExecutionResult{
            Server:   server,
            Error:    fmt.Errorf("operation timed out after %v", e.timeout),
            Duration: time.Since(start),
        }
    }
}
```

### Resource Management
```go
// Resource management and monitoring
type ResourceManager struct {
    maxMemoryMB     int
    maxConnections  int
    currentMemory   int64
    currentConnections int
    mutex           sync.RWMutex
    monitors        []ResourceMonitor
}

type ResourceMonitor interface {
    OnMemoryUsage(bytes int64)
    OnConnectionCount(count int)
    OnResourceExhaustion(resourceType string)
}

func NewResourceManager(maxMemoryMB, maxConnections int) *ResourceManager {
    return &ResourceManager{
        maxMemoryMB:    maxMemoryMB,
        maxConnections: maxConnections,
        monitors:       make([]ResourceMonitor, 0),
    }
}

func (r *ResourceManager) AllocateMemory(bytes int64) error {
    r.mutex.Lock()
    defer r.mutex.Unlock()
    
    newTotal := r.currentMemory + bytes
    maxBytes := int64(r.maxMemoryMB) * 1024 * 1024
    
    if newTotal > maxBytes {
        r.notifyResourceExhaustion("memory")
        return fmt.Errorf("memory allocation would exceed limit: %d > %d bytes", newTotal, maxBytes)
    }
    
    r.currentMemory = newTotal
    r.notifyMemoryUsage(r.currentMemory)
    return nil
}

func (r *ResourceManager) ReleaseMemory(bytes int64) {
    r.mutex.Lock()
    defer r.mutex.Unlock()
    
    r.currentMemory = max(0, r.currentMemory-bytes)
    r.notifyMemoryUsage(r.currentMemory)
}

func (r *ResourceManager) AllocateConnection() error {
    r.mutex.Lock()
    defer r.mutex.Unlock()
    
    if r.currentConnections >= r.maxConnections {
        r.notifyResourceExhaustion("connections")
        return fmt.Errorf("connection limit reached: %d", r.maxConnections)
    }
    
    r.currentConnections++
    r.notifyConnectionCount(r.currentConnections)
    return nil
}

func (r *ResourceManager) ReleaseConnection() {
    r.mutex.Lock()
    defer r.mutex.Unlock()
    
    r.currentConnections = max(0, r.currentConnections-1)
    r.notifyConnectionCount(r.currentConnections)
}

func (r *ResourceManager) notifyMemoryUsage(bytes int64) {
    for _, monitor := range r.monitors {
        monitor.OnMemoryUsage(bytes)
    }
}

func (r *ResourceManager) notifyConnectionCount(count int) {
    for _, monitor := range r.monitors {
        monitor.OnConnectionCount(count)
    }
}

func (r *ResourceManager) notifyResourceExhaustion(resourceType string) {
    for _, monitor := range r.monitors {
        monitor.OnResourceExhaustion(resourceType)
    }
}
```

### Tag-Based Targeting
```go
// Tag-based targeting for flexible server grouping
type TagBasedTargeting struct {
    servers map[string]ServerInfo
    mutex   sync.RWMutex
}

type ServerInfo struct {
    Hostname string
    Tags     map[string]string
    Metadata map[string]interface{}
}

func NewTagBasedTargeting() *TagBasedTargeting {
    return &TagBasedTargeting{
        servers: make(map[string]ServerInfo),
    }
}

func (t *TagBasedTargeting) AddServer(hostname string, tags map[string]string, metadata map[string]interface{}) {
    t.mutex.Lock()
    defer t.mutex.Unlock()
    
    t.servers[hostname] = ServerInfo{
        Hostname: hostname,
        Tags:     tags,
        Metadata: metadata,
    }
}

func (t *TagBasedTargeting) GetServersByTags(tagFilters map[string]string) []string {
    t.mutex.RLock()
    defer t.mutex.RUnlock()
    
    var matchingServers []string
    
    for hostname, server := range t.servers {
        if t.matchesTags(server.Tags, tagFilters) {
            matchingServers = append(matchingServers, hostname)
        }
    }
    
    return matchingServers
}

func (t *TagBasedTargeting) matchesTags(serverTags, filterTags map[string]string) bool {
    for filterKey, filterValue := range filterTags {
        if serverValue, exists := serverTags[filterKey]; !exists || serverValue != filterValue {
            return false
        }
    }
    return true
}

func (t *TagBasedTargeting) GetServersByComplexQuery(query string) ([]string, error) {
    // Implement complex query parsing (e.g., "environment=production AND datacenter=fra00")
    // This could use a simple expression parser or integrate with a query language
    
    // For now, implement basic AND/OR logic
    if strings.Contains(query, " AND ") {
        return t.parseAndQuery(query)
    } else if strings.Contains(query, " OR ") {
        return t.parseOrQuery(query)
    } else {
        return t.parseSimpleQuery(query)
    }
}

func (t *TagBasedTargeting) parseAndQuery(query string) ([]string, error) {
    parts := strings.Split(query, " AND ")
    if len(parts) != 2 {
        return nil, fmt.Errorf("invalid AND query format")
    }
    
    left, err := t.parseSimpleQuery(strings.TrimSpace(parts[0]))
    if err != nil {
        return nil, err
    }
    
    right, err := t.parseSimpleQuery(strings.TrimSpace(parts[1]))
    if err != nil {
        return nil, err
    }
    
    // Find intersection
    leftSet := make(map[string]bool)
    for _, server := range left {
        leftSet[server] = true
    }
    
    var result []string
    for _, server := range right {
        if leftSet[server] {
            result = append(result, server)
        }
    }
    
    return result, nil
}
