## Release Process

### Automated Release Workflow
```go
// Release automation
type ReleaseInfo struct {
    Version     string
    BuildTime   string
    GitCommit   string
    Assets      []string
    ReleaseNotes string
}

func CreateRelease(info ReleaseInfo) error {
    // 1. Validate version format
    if err := validateVersion(info.Version); err != nil {
        return fmt.Errorf("invalid version: %w", err)
    }
    
    // 2. Build all targets
    if err := buildAllTargets(); err != nil {
        return fmt.Errorf("build failed: %w", err)
    }
    
    // 3. Generate checksums
    if err := generateChecksums(); err != nil {
        return fmt.Errorf("checksum generation failed: %w", err)
    }
    
    // 4. Create GitHub release
    if err := createGitHubRelease(info); err != nil {
        return fmt.Errorf("GitHub release failed: %w", err)
    }
    
    // 5. Update package managers
    if err := updatePackageManagers(info); err != nil {
        return fmt.Errorf("package manager update failed: %w", err)
    }
    
    return nil
}
```

### Version Management
```go
// Semantic versioning
type Version struct {
    Major int
    Minor int
    Patch int
    Pre   string
    Build string
}

func ParseVersion(s string) (Version, error) {
    // Parse semantic version string
    // Format: v1.2.3-alpha+build
    re := regexp.MustCompile(`^v?(\d+)\.(\d+)\.(\d+)(?:-([^+]+))?(?:\+(.+))?$`)
    matches := re.FindStringSubmatch(s)
    
    if len(matches) < 4 {
        return Version{}, fmt.Errorf("invalid version format: %s", s)
    }
    
    major, _ := strconv.Atoi(matches[1])
    minor, _ := strconv.Atoi(matches[2])
    patch, _ := strconv.Atoi(matches[3])
    
    return Version{
        Major: major,
        Minor: minor,
        Patch: patch,
        Pre:   matches[4],
        Build: matches[5],
    }, nil
}
```

