### Pre-commit Hook Implementation
```go
// tools/pre-commit/main.go
package main

import (
    "fmt"
    "os"
    "os/exec"
    "path/filepath"
)

func main() {
    checks := []struct {
        name string
        cmd  []string
    }{
        {"gofmt", []string{"gofmt", "-l", "."}},
        {"golangci-lint", []string{"golangci-lint", "run"}},
        {"tests", []string{"go", "test", "-v", "./..."}},
        {"coverage", []string{"go", "test", "-coverprofile=coverage.out", "./..."}},
    }

    for _, check := range checks {
        fmt.Printf("Running %s...\n", check.name)
        cmd := exec.Command(check.cmd[0], check.cmd[1:]...)
        cmd.Stdout = os.Stdout
        cmd.Stderr = os.Stderr
        
        if err := cmd.Run(); err != nil {
            fmt.Printf("❌ %s failed: %v\n", check.name, err)
            os.Exit(1)
        }
        fmt.Printf("✅ %s passed\n", check.name)
    }
    
    fmt.Println("🎉 All pre-commit checks passed!")
}
```

### Development Environment Setup
```go
// Test environment configuration
type TestEnvironment struct {
    PodmanEnabled bool
    MockSSHServer bool
    TestDataPath  string
    TempDir       string
}

func SetupTestEnvironment() (*TestEnvironment, error) {
    env := &TestEnvironment{
        PodmanEnabled: checkPodmanAvailable(),
        MockSSHServer: true,
        TestDataPath:  "testdata",
        TempDir:       createTempDir(),
    }
    
    if err := env.initialize(); err != nil {
        return nil, fmt.Errorf("failed to setup test environment: %w", err)
    }
    
    return env, nil
}

func (e *TestEnvironment) initialize() error {
    // Setup mock SSH server
    if e.MockSSHServer {
        if err := e.startMockSSHServer(); err != nil {
            return fmt.Errorf("failed to start mock SSH server: %w", err)
        }
    }
    
    // Setup test data
    if err := e.setupTestData(); err != nil {
        return fmt.Errorf("failed to setup test data: %w", err)
    }
    
    return nil
}
```

## Tool Configuration Patterns

### golangci-lint Configuration
```yaml
# .golangci.yml
run:
  timeout: 5m
  go: "1.24"
  modules-download-mode: readonly

linters:
  enable:
    - gofmt
    - govet
    - errcheck
    - staticcheck
    - gosimple
    - ineffassign
    - unused
    - misspell
    - gosec
    - gocyclo
    - dupl
    - goconst
    - gocritic
    - goimports

linters-settings:
  gocyclo:
    min-complexity: 10
  dupl:
    threshold: 100
  goconst:
    min-len: 3
    min-occurrences: 3

issues:
  exclude-rules:
    - path: _test\.go
      linters:
        - gocyclo
        - dupl
```

### Coverage Tool Configuration
```go
// Coverage threshold configuration
type CoverageConfig struct {
    OverallThreshold    float64
    PackageThreshold    float64
    FileThreshold       float64
    ExcludePatterns     []string
    IncludePatterns     []string
}

func DefaultCoverageConfig() CoverageConfig {
    return CoverageConfig{
        OverallThreshold: 75.0,
        PackageThreshold: 70.0,
        FileThreshold:    60.0,
        ExcludePatterns: []string{
            "cmd/",
            "tools/",
            "examples/",
        },
        IncludePatterns: []string{
            "internal/",
        },
    }
}
```

## Development Workflow

### Feature Development Process
```bash
# 1. Create feature branch
git checkout -b feature/new-feature

# 2. Make changes and commit
git add .
git commit -m "feat: implement new feature"

# 3. Run pre-commit checks
just check                    # Run all checks (format, deps, lint, test)
just test-coverage           # Generate coverage report

# 4. Push and create PR
git push origin feature/new-feature
```

### Development Workflow Commands
```bash
# Complete development workflow
just dev                     # Build, test, and show version

# Complete release workflow
just release                 # Clean, check, build, test, version

# Individual quality checks
just check-fmt              # Check code formatting
just check-deps             # Check for unused dependencies
just lint                   # Run linter
just lint-todos             # AI-optimized linting analysis
just test                   # Run all tests with coverage
just test-unit              # Run unit tests only
just test-integration       # Run integration tests only
```

### Emergency Fix Process
```bash
# For emergency fixes only
git add .
git commit --no-verify -m "fix: emergency fix for critical issue"
git push origin main

# Follow up with proper testing
just test
just lint
```

