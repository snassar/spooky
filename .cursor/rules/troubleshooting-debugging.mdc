# Troubleshooting and Debugging Patterns

## Quick Reference for AI Assistants

### Decision Tree: Which Troubleshooting Approach to Use?

1. **Are you debugging a runtime error?**
   - **Yes** → Use error analysis patterns
   - **No** → Continue to step 2

2. **Are you troubleshooting configuration issues?**
   - **Yes** → Use configuration validation patterns
   - **No** → Continue to step 3

3. **Are you debugging performance issues?**
   - **Yes** → Use performance analysis patterns
   - **No** → Use general debugging patterns

### AI Action Items

**ALWAYS DO:**
- Start with the simplest explanation first
- Use systematic debugging approaches
- Check logs and error messages
- Validate assumptions step by step
- Document the debugging process

**NEVER DO:**
- Make random changes without understanding the issue
- Ignore error messages and logs
- Skip validation steps
- Assume the problem is elsewhere without evidence

## Error Analysis Patterns

### 1. Error Message Analysis

#### Parse Error Messages
```go
// Good: Comprehensive error analysis
func analyzeError(err error) (string, []string) {
    if err == nil {
        return "No error", nil
    }
    
    var suggestions []string
    
    // Check for common error types
    switch {
    case strings.Contains(err.Error(), "connection refused"):
        suggestions = append(suggestions,
            "Check if the service is running",
            "Verify port configuration",
            "Check firewall settings",
            "Ensure network connectivity")
        
    case strings.Contains(err.Error(), "permission denied"):
        suggestions = append(suggestions,
            "Check file permissions",
            "Verify user access rights",
            "Check SSH key permissions (should be 600)",
            "Ensure proper authentication")
        
    case strings.Contains(err.Error(), "file not found"):
        suggestions = append(suggestions,
            "Verify file path exists",
            "Check working directory",
            "Ensure file permissions allow reading",
            "Validate file path format")
        
    case strings.Contains(err.Error(), "invalid syntax"):
        suggestions = append(suggestions,
            "Check HCL syntax (brackets, quotes)",
            "Validate required fields are present",
            "Check for typos in field names",
            "Ensure proper value types")
    }
    
    return err.Error(), suggestions
}
```

#### Error Context Extraction
```go
// Good: Extract context from errors
func extractErrorContext(err error) map[string]interface{} {
    context := make(map[string]interface{})
    
    // Extract error type
    context["error_type"] = reflect.TypeOf(err).String()
    context["error_message"] = err.Error()
    
    // Extract wrapped errors
    if wrapped, ok := err.(interface{ Unwrap() error }); ok {
        if unwrapped := wrapped.Unwrap(); unwrapped != nil {
            context["wrapped_error"] = extractErrorContext(unwrapped)
        }
    }
    
    // Extract validation errors
    if validationErr, ok := err.(interface{ Field() string }); ok {
        context["field"] = validationErr.Field()
    }
    
    return context
}
```

### 2. Log Analysis Patterns

#### Structured Log Parsing
```go
// Good: Parse structured logs for debugging
func parseStructuredLogs(logData []byte) ([]LogEntry, error) {
    var entries []LogEntry
    
    lines := strings.Split(string(logData), "\n")
    for i, line := range lines {
        if strings.TrimSpace(line) == "" {
            continue
        }
        
        entry, err := parseLogLine(line)
        if err != nil {
            // Log parsing error but continue
            log.Printf("Failed to parse log line %d: %v", i+1, err)
            continue
        }
        
        entries = append(entries, entry)
    }
    
    return entries, nil
}

type LogEntry struct {
    Timestamp time.Time
    Level     string
    Message   string
    Fields    map[string]interface{}
}

func parseLogLine(line string) (LogEntry, error) {
    // Parse structured log format
    // Example: 2024-01-01T12:00:00Z INFO "message" field1=value1 field2=value2
    
    parts := strings.SplitN(line, " ", 4)
    if len(parts) < 4 {
        return LogEntry{}, fmt.Errorf("invalid log line format")
    }
    
    timestamp, err := time.Parse(time.RFC3339, parts[0])
    if err != nil {
        return LogEntry{}, fmt.Errorf("invalid timestamp: %w", err)
    }
    
    level := parts[1]
    message := strings.Trim(parts[2], `"`)
    
    // Parse structured fields
    fields := make(map[string]interface{})
    if len(parts) > 3 {
        fieldPairs := strings.Split(parts[3], " ")
        for _, pair := range fieldPairs {
            if kv := strings.SplitN(pair, "=", 2); len(kv) == 2 {
                fields[kv[0]] = kv[1]
            }
        }
    }
    
    return LogEntry{
        Timestamp: timestamp,
        Level:     level,
        Message:   message,
        Fields:    fields,
    }, nil
}
```

## Configuration Validation Patterns

### 1. HCL Configuration Debugging

#### Configuration Structure Validation
```go
// Good: Validate configuration structure
func validateConfigurationStructure(configPath string) error {
    data, err := os.ReadFile(configPath)
    if err != nil {
        return fmt.Errorf("failed to read config file: %w", err)
    }
    
    // Check for basic HCL syntax
    var result interface{}
    if err := hcl.Unmarshal(data, &result); err != nil {
        return fmt.Errorf("HCL syntax error: %w", err)
    }
    
    // Check for required blocks
    if !containsBlock(data, "project") {
        return fmt.Errorf("missing required 'project' block")
    }
    
    // Check for duplicate blocks
    if hasDuplicateBlocks(data, "project") {
        return fmt.Errorf("duplicate 'project' blocks found")
    }
    
    return nil
}

func containsBlock(data []byte, blockName string) bool {
    return strings.Contains(string(data), blockName+" {")
}

func hasDuplicateBlocks(data []byte, blockName string) bool {
    pattern := blockName + " {"
    count := strings.Count(string(data), pattern)
    return count > 1
}
```

#### Configuration Value Validation
```go
// Good: Validate configuration values
func validateConfigurationValues(config *spookytypes.Config) []string {
    var issues []string
    
    // Validate project configuration
    if config.Project != nil {
        if config.Project.Name == "" {
            issues = append(issues, "project.name is required")
        }
        
        if config.Project.Description == "" {
            issues = append(issues, "project.description is recommended")
        }
        
        // Validate metadata
        if config.Project.Metadata != nil {
            if config.Project.Metadata.Version == "" {
                issues = append(issues, "project.metadata.version is recommended")
            }
        }
    }
    
    // Validate machine configuration
    if config.Machines != nil {
        for i, machine := range config.Machines {
            if machine.Hostname == "" {
                issues = append(issues, fmt.Sprintf("machines[%d].hostname is required", i))
            }
            
            if machine.Port <= 0 || machine.Port > 65535 {
                issues = append(issues, fmt.Sprintf("machines[%d].port must be 1-65535", i))
            }
            
            if machine.User == "" {
                issues = append(issues, fmt.Sprintf("machines[%d].user is required", i))
            }
        }
    }
    
    return issues
}
```

### 2. Environment Variable Debugging

#### Environment Configuration Analysis
```go
// Good: Analyze environment configuration
func analyzeEnvironmentConfiguration() map[string]interface{} {
    analysis := make(map[string]interface{})
    
    // Check XDG directories
    xdgConfigHome := os.Getenv("XDG_CONFIG_HOME")
    if xdgConfigHome == "" {
        xdgConfigHome = filepath.Join(os.Getenv("HOME"), ".config")
    }
    analysis["xdg_config_home"] = xdgConfigHome
    
    // Check spooky-specific environment variables
    spookyVars := []string{
        "SPOOKY_CONFIG_PATH",
        "SPOOKY_LOG_LEVEL",
        "SPOOKY_FACTS_PATH",
        "SPOOKY_FACTS_FORMAT",
    }
    
    for _, varName := range spookyVars {
        if value := os.Getenv(varName); value != "" {
            analysis[varName] = value
        }
    }
    
    // Check file permissions
    configPath := filepath.Join(xdgConfigHome, "spooky", "spooky.hcl")
    if info, err := os.Stat(configPath); err == nil {
        analysis["config_file_permissions"] = info.Mode().String()
        analysis["config_file_owner"] = getFileOwner(info)
    }
    
    return analysis
}

func getFileOwner(info os.FileInfo) string {
    if stat, ok := info.Sys().(*syscall.Stat_t); ok {
        if user, err := user.LookupId(strconv.FormatUint(uint64(stat.Uid), 10)); err == nil {
            return user.Username
        }
    }
    return "unknown"
}
```

## Performance Analysis Patterns

### 1. Performance Profiling

#### Basic Performance Measurement
```go
// Good: Measure function performance
func measurePerformance(operation string, fn func() error) (time.Duration, error) {
    start := time.Now()
    
    err := fn()
    
    duration := time.Since(start)
    
    // Log performance metrics
    log.Printf("Performance: %s took %v", operation, duration)
    
    return duration, err
}

// Usage example
func examplePerformanceMeasurement() {
    duration, err := measurePerformance("fact collection", func() error {
        return collectFacts("server1")
    })
    
    if err != nil {
        log.Printf("Operation failed after %v", duration)
    } else {
        log.Printf("Operation completed in %v", duration)
    }
}
```

#### Memory Usage Analysis
```go
// Good: Analyze memory usage
func analyzeMemoryUsage() map[string]interface{} {
    var m runtime.MemStats
    runtime.ReadMemStats(&m)
    
    return map[string]interface{}{
        "alloc":      m.Alloc,
        "total_alloc": m.TotalAlloc,
        "sys":        m.Sys,
        "num_gc":     m.NumGC,
        "heap_alloc": m.HeapAlloc,
        "heap_sys":   m.HeapSys,
        "heap_idle":  m.HeapIdle,
        "heap_inuse": m.HeapInuse,
    }
}
```

### 2. Bottleneck Identification

#### Identify Slow Operations
```go
// Good: Identify performance bottlenecks
func identifyBottlenecks(operations []string) map[string]time.Duration {
    results := make(map[string]time.Duration)
    
    for _, op := range operations {
        duration, _ := measurePerformance(op, func() error {
            // Simulate operation
            time.Sleep(time.Millisecond * 100)
            return nil
        })
        
        results[op] = duration
    }
    
    // Sort by duration to identify bottlenecks
    var sortedOps []string
    for op := range results {
        sortedOps = append(sortedOps, op)
    }
    
    sort.Slice(sortedOps, func(i, j int) bool {
        return results[sortedOps[i]] > results[sortedOps[j]]
    })
    
    log.Printf("Performance ranking (slowest first):")
    for _, op := range sortedOps {
        log.Printf("  %s: %v", op, results[op])
    }
    
    return results
}
```

## Debugging Workflow

### 1. Systematic Debugging Steps

#### Debugging Checklist
```go
// Good: Systematic debugging approach
func systematicDebugging(issue string) []string {
    steps := []string{
        "1. Reproduce the issue consistently",
        "2. Check error messages and logs",
        "3. Validate configuration files",
        "4. Check environment variables",
        "5. Verify file permissions and paths",
        "6. Test with minimal configuration",
        "7. Check for recent changes",
        "8. Validate input data",
        "9. Check system resources",
        "10. Review related code paths",
    }
    
    log.Printf("Debugging issue: %s", issue)
    for _, step := range steps {
        log.Printf("  %s", step)
    }
    
    return steps
}
```

### 2. Debug Information Collection

#### Collect Debug Information
```go
// Good: Collect comprehensive debug information
func collectDebugInfo() map[string]interface{} {
    info := make(map[string]interface{})
    
    // System information
    info["go_version"] = runtime.Version()
    info["go_os"] = runtime.GOOS
    info["go_arch"] = runtime.GOARCH
    info["num_cpu"] = runtime.NumCPU()
    info["num_goroutines"] = runtime.NumGoroutine()
    
    // Memory information
    info["memory"] = analyzeMemoryUsage()
    
    // Environment information
    info["environment"] = analyzeEnvironmentConfiguration()
    
    // File system information
    info["working_directory"] = getWorkingDirectory()
    info["file_permissions"] = getFilePermissions()
    
    return info
}

func getWorkingDirectory() string {
    if wd, err := os.Getwd(); err == nil {
        return wd
    }
    return "unknown"
}

func getFilePermissions() map[string]string {
    permissions := make(map[string]string)
    
    files := []string{
        "project.hcl",
        "machines.hcl",
        "actions.hcl",
        "variables.hcl",
    }
    
    for _, file := range files {
        if info, err := os.Stat(file); err == nil {
            permissions[file] = info.Mode().String()
        }
    }
    
    return permissions
}
```

